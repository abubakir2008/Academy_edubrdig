# Traefik gateway used by server components and by the /api/* rewrite.
# Local dev (compose exposes traefik on :80):
API_GATEWAY_URL=http://localhost
# Inside docker-compose use the service name instead:
# API_GATEWAY_URL=http://traefik

# Browser-side base path. Leave as /api to go through the Next rewrite.
NEXT_PUBLIC_API_BASE=/api

# Currency used for budget filters (tutor cards always use the tutor's own code).
NEXT_PUBLIC_CURRENCY=USD

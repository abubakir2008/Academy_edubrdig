# ─────────────────────────────────────────────────────────────
# PRODUCTION ENVIRONMENT TEMPLATE — platform/ (backend)
# On the server: cp .env.production.example .env, then fill in every
# CHANGE_ME. NEVER commit the real platform/.env to git.
#
# Everything not marked CHANGE_ME below is optional — AI/Zoom/OAuth/SMTP
# gate specific features and can stay empty until that feature is needed
# (see the longer comments in .env.example for what each one does).
# ─────────────────────────────────────────────────────────────

ENVIRONMENT=production
LOG_LEVEL=INFO

# ---- JWT / Security ----
# Generate a REAL keypair for this server — never reuse a dev/staging one:
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# Paste each PEM below as a single line with real newlines replaced by \n.
JWT_PRIVATE_KEY=CHANGE_ME
JWT_PUBLIC_KEY=CHANGE_ME
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_RATE_LIMIT_PER_MIN=10

# Generate with: openssl rand -hex 32
INTERNAL_SECRET=CHANGE_ME_LONG_RANDOM_HEX

# ---- PostgreSQL ----
# `edubridge_academy`, not the dev default `edubridge` — this server
# already runs edubridge_university/edubridge_jobs for the sibling
# EduBridge projects; a distinct name keeps docker ps / backups / psql
# sessions unambiguous across all three.
POSTGRES_USER=edubridge_academy
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=edubridge_academy
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
EVENT_STREAM_MAXLEN=10000

# ---- MinIO (only needed if you run the `full` compose profile) ----
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_HOST=minio
MINIO_PORT=9000
# Not reachable from the browser until something on the shared gateway
# actually proxies to it — see the storage note in DEPLOY.md before
# enabling the `full` profile in production.
MINIO_PUBLIC_ENDPOINT=academy.edubridge.bond

# ---- API / security ----
# The real frontend origin, never `*` — the browser drops credentialed
# requests from a wildcard CORS origin.
CORS_ORIGINS=https://academy.edubridge.bond
RATE_LIMIT_PER_MIN=120

# ---- Email (SMTP) ----
# MailHog (the dev default) doesn't exist in prod — point this at a real
# provider (SendGrid, Mailgun, your own Postfix, etc.).
EMAIL_ENABLED=true
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=EduBridge <no-reply@academy.edubridge.bond>
SMTP_TLS=true

# ---- AI (content department) — optional, falls back to local templates ----
AI_DAILY_LIMIT=100
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=1024
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---- OAuth (identity department) — optional ----
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ---- Zoom (calendar department) — optional, but lesson creation 409s with
# a clear "Zoom is not configured" error until this is set ----
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=https://academy.edubridge.bond/api/calendar/zoom/callback
FRONTEND_URL=https://academy.edubridge.bond
# Generate with: openssl rand -hex 32
ZOOM_STATE_SECRET=CHANGE_ME_LONG_RANDOM_HEX

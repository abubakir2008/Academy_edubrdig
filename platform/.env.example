# ==========================================================================
# EduBridge Platform - environment variables
# Copy to `.env` and adjust for local development.
#
# Consolidated for the department topology (identity, engagement, content,
# backoffice): one Postgres database (schema per department, not database
# per service), Redis for tokens/rate-limit/realtime/event-bus, and no more
# Mongo/ElasticSearch/Kafka/RabbitMQ.
# ==========================================================================

# ---- General ----
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- JWT / Security ----
# RS256: only identity signs (JWT_PRIVATE_KEY — set this for identity ONLY,
# never for any other department). Every department, including identity
# itself for verification, gets JWT_PUBLIC_KEY, which can check a signature
# but not forge one — a future compromise in any one department can't be
# used to mint tokens for the rest of the platform. Generate a pair with:
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# then paste each PEM in as a single line with real newlines replaced by
# literal \n (both fields are unescaped automatically on load).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Requests per minute per IP to POST /auth/login specifically — separate,
# much stricter budget than RATE_LIMIT_PER_MIN below (see identity/app/main.py).
AUTH_RATE_LIMIT_PER_MIN=10

# Shared secret for service-to-service calls (edubridge_shared.clients).
# Leave empty in local dev (the guard is disabled with a warning); set a
# long random value (e.g. `openssl rand -hex 32`) in production.
INTERNAL_SECRET=

# ---- PostgreSQL (one database; each department owns its own schema) ----
POSTGRES_USER=edubridge
POSTGRES_PASSWORD=edubridge
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=edubridge
# Small per-department pools by design — see edubridge_shared/config.py.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2

# ---- Redis (tokens db0, rate-limit db2, realtime db3, events db4) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
EVENT_STREAM_MAXLEN=10000

# ---- MinIO (object storage; content department, `storage` route) ----
MINIO_ROOT_USER=edubridge
MINIO_ROOT_PASSWORD=edubridge123
MINIO_HOST=minio
MINIO_PORT=9000
# Host:port a BROWSER can reach for presigned upload/download URLs — internal
# calls (bucket bootstrap) always use MINIO_HOST above regardless of this.
# In production, put this behind the same domain/TLS as everything else.
MINIO_PUBLIC_ENDPOINT=localhost:9000

# ---- API / security ----
# Comma-separated allowed origins for the browser frontend, or * for dev.
CORS_ORIGINS=*
# Requests per minute per client IP per path (0 disables rate limiting).
RATE_LIMIT_PER_MIN=120

# ---- Email (SMTP) — defaults target local MailHog (UI http://localhost:8025) ----
# engagement department (notifications module)
EMAIL_ENABLED=true
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=EduBridge <no-reply@edubridge.local>
SMTP_TLS=false

# ---- AI (content department) ----
# Leave ANTHROPIC_API_KEY empty to run on local templates only (no external
# calls, no cost) — homework generation and lesson analysis both say which
# mode answered via a "source" field in the response.
AI_DAILY_LIMIT=100
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=1024
# Free-tier fallback for local/test use (aistudio.google.com, no card needed).
# Anthropic wins if both keys are set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---- OAuth (identity department) ----
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ---- LiveKit (calendar department — in-app video calls) ----
# One project, no per-tutor account linking: a lesson's video call is a
# LiveKit room, and a join token is minted per participant on request (see
# calendar's services/livekit_client.py). Get these from a LiveKit Cloud
# project (cloud.livekit.io) or your own self-hosted server. Leave empty and
# joining a lesson fails with a clear "LiveKit is not configured" error
# instead of a dead video screen.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Lesson recordings (calendar department) — optional ----
# LiveKit's own egress workers upload the finished recording straight to
# this S3-compatible bucket (Cloudflare R2 recommended — no egress fees,
# matters for video). Leave empty and lessons simply aren't recorded; no
# error, nothing else is affected. See calendar's services/recordings.py.
# RECORDINGS_S3_ENDPOINT is the bucket's S3 API host with no scheme, e.g.
# <account_id>.r2.cloudflarestorage.com.
RECORDINGS_S3_ENDPOINT=
RECORDINGS_S3_ACCESS_KEY=
RECORDINGS_S3_SECRET_KEY=
RECORDINGS_S3_BUCKET=

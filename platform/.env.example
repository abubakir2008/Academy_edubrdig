# ==========================================================================
# EduBridge Platform - environment variables
# Copy to `.env` and adjust for local development.
#
# Consolidated for the 7-department topology: one Postgres database (schema
# per department, not database per service), Redis for tokens/rate-limit/
# realtime/event-bus, and no more Mongo/ElasticSearch/Kafka/RabbitMQ.
# ==========================================================================

# ---- General ----
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- JWT / Security (shared across every department) ----
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Shared secret for service-to-service calls (edubridge_shared.clients).
# Leave empty in local dev; set a long random value in production.
INTERNAL_SECRET=

# ---- PostgreSQL (one database; each department owns its own schema) ----
POSTGRES_USER=edubridge
POSTGRES_PASSWORD=edubridge
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=edubridge
# Small per-department pools by design — see edubridge_shared/config.py.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2

# ---- Redis (tokens db0, video db1, rate-limit db2, realtime db3, events db4) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
EVENT_STREAM_MAXLEN=10000

# ---- MinIO (object storage; content department, `storage` route) ----
MINIO_ROOT_USER=edubridge
MINIO_ROOT_PASSWORD=edubridge123
MINIO_HOST=minio
MINIO_PORT=9000
# Host:port a BROWSER can reach for presigned upload/download URLs — internal
# calls (bucket bootstrap) always use MINIO_HOST above regardless of this.
# In production, put this behind the same domain/TLS as everything else.
MINIO_PUBLIC_ENDPOINT=localhost:9000

# ---- Video (scheduling department, `video` route) ----
# Free public Jitsi instance by default — zero extra RAM on a small VPS.
# Point this at your own self-hosted Jitsi stack's domain later if you want
# to; nothing else in the code needs to change.
JITSI_DOMAIN=meet.jit.si

# ---- API / security ----
# Comma-separated allowed origins for the browser frontend, or * for dev.
CORS_ORIGINS=*
# Requests per minute per client IP (0 disables rate limiting).
RATE_LIMIT_PER_MIN=0

# ---- Payments (finance department) ----
PLATFORM_COMMISSION_RATE=0.20
# Gateway: mock (default, settles instantly) | paybox
PAYMENT_PROVIDER=mock
PAYBOX_MERCHANT_ID=
PAYBOX_SECRET_KEY=
PAYMENT_RETURN_URL=http://localhost/api/payments/webhook/paybox

# ---- Email (SMTP) — defaults target local MailHog (UI http://localhost:8025) ----
# engagement department (notifications module)
EMAIL_ENABLED=true
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=EduBridge <no-reply@edubridge.local>
SMTP_TLS=false

# ---- AI (content department) ----
# Leave ANTHROPIC_API_KEY empty to run on local templates only (no external
# calls, no cost) — homework generation and lesson analysis both say which
# mode answered via a "source" field in the response.
AI_DAILY_LIMIT=100
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=1024
# Free-tier fallback for local/test use (aistudio.google.com, no card needed).
# Anthropic wins if both keys are set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---- OAuth (identity department) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
